<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse-proxy for meridian-briefing (CR DEV server, Phase 3).

  Lets in-network users reach the briefing at a friendly IIS hostname/port (with
  TLS, if the site is bound to a cert) WITHOUT signing onto the server: their
  browser talks to IIS; IIS forwards every request to the PowerShell server,
  which stays bound to 127.0.0.1:8788 and is never directly reachable.

      In-network user ──https──► IIS site (this web.config) ──http──► 127.0.0.1:8788 (server.ps1)

  This config makes IIS a pure pass-through (it serves NO files of its own), so
  the SPA's absolute "/api/..." and "/" paths work unchanged. Keep
  HOST=127.0.0.1 PORT=8788 in .env (IIS is the only client).

  ── ONE-TIME PREREQUISITES (Billy / server admin) ──────────────────────────
  1. Install the IIS modules "URL Rewrite" and "Application Request Routing (ARR)".
  2. Enable ARR proxying at the server level (once per server):
       %windir%\system32\inetsrv\appcmd.exe set config ^
         -section:system.webServer/proxy /enabled:"true" /commit:apphost
  3. Create an IIS site bound to the hostname/port providers will use (and a TLS
     cert for https). Point its physical path at any folder containing THIS file
     (e.g. C:\inetpub\meridian-briefing\ with just this web.config in it -- it
     does not need the repo; the PowerShell server serves the actual content).
  4. Open the firewall for that IIS binding only. Do NOT expose 8788.

  If ARR cannot be installed, skip IIS entirely: set HOST=0.0.0.0 in .env and
  have Billy open the firewall on PORT -- providers then reach it at
  http://<server-host>:8788/ directly (see deploy/README-server.md "The model").
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Forward every request, preserving path + query, to the local server. -->
        <rule name="meridian-briefing-reverse-proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8788/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- ARR forwards Set-Cookie / Cookie both ways, so the HttpOnly SameSite=Lax
         admin session works through the proxy with no extra config. The server
         already sends Cache-Control: no-store on API responses. -->
    <security>
      <requestFiltering>
        <!-- server.ps1 caps bodies at 2 MB itself; this just keeps IIS from
             rejecting a normal large edition save before it reaches the server. -->
        <requestLimits maxAllowedContentLength="5242880" />
      </requestFiltering>
    </security>

    <!-- Don't let IIS inject its own error pages over the proxied responses. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
