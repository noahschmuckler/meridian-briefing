# meridian-briefing — server configuration (shared by BOTH runtimes).
# Copy to .env. Then either:
#   Node    :  node --env-file=.env server.js   (or: npm run dev)
#   No-Node :  powershell -File deploy\server.ps1   (reads this same .env)
# The two servers are interchangeable — same keys, same state.json, same hash.
#
# Every value is optional EXCEPT the ADMIN_PASSWORD_* pair — without it, the
# /admin login returns 503 "not configured" and nobody can edit (the read-only
# provider view still works). Generate the pair (PBKDF2-HMAC-SHA256) with
# `npm run hash-password` (Node) or `scripts\hash-password.ps1` (Windows/no-Node)
# — both emit the identical hash. NOTE: hashes from the old scrypt build no
# longer verify; regenerate the pair with the current hasher.

# Port / host the server listens on.
#   Dev + orange device : HOST=127.0.0.1  (localhost only)
#   CR DEV server        : HOST=0.0.0.0    (accept in-network connections; Billy
#                                           fronts TLS via IIS or opens the port)
# Default 8788 (8787 is taken by the throughline app on the orange device).
PORT=8788
HOST=127.0.0.1

# Where the single state document lives. Relative paths resolve against the repo
# root. On the server, point this at a persistent path outside the clone, e.g.
#   BRIEFING_DB=D:\meridian-briefing-data\state.json
BRIEFING_DB=./data/state.json

# Admin gate (single shared password). Generate BOTH lines with
# `npm run hash-password` (prompts for a password, prints these two lines).
# NEVER commit real values — .env is gitignored.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# Admin session lifetime in days. Sessions live in server memory only, so a
# server restart logs everyone out regardless of this value.
SESSION_TTL_DAYS=7

# ── Usage tracking (QI analytics; optional) ──
# Directory for the append-only usage log (monthly usage-YYYY-MM.jsonl files).
# Relative paths resolve against the BRIEFING_DB folder. Default: a `usage/`
# folder beside state.json. Point it at a persistent path on the server.
#   USAGE_LOG=D:\meridian-briefing-data\usage
# USAGE_LOG=
#
# Who is recorded per event:
#   PowerShell server : the Windows identity from a transparent Negotiate
#       handshake on /api/track (domain machines in the Local-Intranet zone send
#       it silently; the app itself never prompts). Nothing to configure.
#   Node dev server   : no Windows auth — identity falls back to the X-Remote-User
#       header (if a proxy sets it) or DEV_USER below, else "anonymous".
# DEV_USER=DEVDOMAIN\\you
